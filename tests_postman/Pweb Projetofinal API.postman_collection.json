        {
          "name": "Listar categorias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const categorias = pm.response.json();",
                  "const praias = categorias.find((categoria) => categoria.slug === 'praias');",
                  "if (praias) {",
                  "  pm.collectionVariables.set('categoriaId', String(praias.id));",
                  "  pm.collectionVariables.set('categoriaSlug', praias.slug);",
                  "}"
